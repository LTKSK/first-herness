{
  "name": "first-hernes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx backend/src/server.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "node scripts/test-mysql.mjs vitest",
    "test:e2e": "node scripts/test-mysql.mjs playwright",
    "preview": "vite preview",
    "test:hooks": "node --test tests/hooks/*.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "mysql2": "^3.24.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
